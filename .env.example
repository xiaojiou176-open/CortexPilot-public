# Codeflow local minimal template (do not commit real secrets)
# Core ports and API auth
CODEFLOW_DEV_HOST=127.0.0.1
CODEFLOW_API_PORT=10000
CODEFLOW_DASHBOARD_PORT=3100
CODEFLOW_DESKTOP_PORT=18173
CODEFLOW_API_AUTH_REQUIRED=true
CODEFLOW_API_TOKEN=codeflow-dev-token

# Frontend runtime wiring (public env for web / desktop shell token)
NEXT_PUBLIC_CODEFLOW_API_BASE=http://127.0.0.1:10000
NEXT_PUBLIC_CODEFLOW_API_TOKEN=codeflow-dev-token
VITE_CODEFLOW_API_BASE=http://127.0.0.1:10000
VITE_CODEFLOW_API_TOKEN=codeflow-dev-token
# Optional hosted/public dashboard origins (comma-separated, no secrets)
CODEFLOW_API_ALLOWED_ORIGINS=
# Later-gated queue pilot stays default-off unless a trusted operator environment enables it.
CODEFLOW_MCP_QUEUE_PILOT_ENABLE_APPLY=0

# Unified LLM provider selection
# Supported: gemini | openai | anthropic
CODEFLOW_PROVIDER=gemini
# Optional overrides (leave empty to use provider defaults)
CODEFLOW_PROVIDER_BASE_URL=
CODEFLOW_PROVIDER_MODEL=
CODEFLOW_PROVIDER_USE_LITELLM=0

# M10 SSOT alignment: prefer canonical MCP timeout keys for new config
CODEFLOW_MCP_TIMEOUT_SEC=
CODEFLOW_MCP_CONNECT_TIMEOUT_SEC=
CODEFLOW_MCP_CLEANUP_TIMEOUT_SEC=
# Compatibility keys are still registered; keep only for legacy/runtime compatibility
CODEFLOW_MCP_SERVER_TIMEOUT_SEC=
CODEFLOW_MCP_SERVER_CONNECT_TIMEOUT_SEC=
CODEFLOW_MCP_SERVER_CLEANUP_TIMEOUT_SEC=

# Provider credentials (fill only what you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_BASE_URL=

# Optional eval overrides
CODEFLOW_EVAL_MODEL=
CODEFLOW_EVAL_CONFIG=tests/evals/promptfoo/promptfooconfig.yaml

# Optional governance knobs
CODEFLOW_RUM_MAX_PAYLOAD_BYTES=32768
CODEFLOW_CI_CANARY_DRY_RUN=0
# Host compatibility only: set to 1 to bypass docker auto-routing for local gate diagnostics.
CODEFLOW_HOST_COMPAT=0
# Repo-authored runtime artifacts stay under .runtime-cache/. Repo-owned external caches stay under ~/.cache/codeflow.
CODEFLOW_MACHINE_CACHE_ROOT=~/.cache/codeflow
CODEFLOW_RETENTION_MACHINE_CACHE_CAP_BYTES=21474836480
CODEFLOW_MACHINE_CACHE_AUTO_PRUNE=1
CODEFLOW_MACHINE_CACHE_AUTO_PRUNE_INTERVAL_SEC=1800
# Local development uses the repo-owned Chrome singleton rooted under ~/.cache/codeflow/browser/.
# First migrate the named default-Chrome profile once, then keep manual and automation flows attached to the same CDP endpoint.
CHROME_PATH=
CODEFLOW_BROWSER_PROFILE_MODE=allow_profile
CODEFLOW_BROWSER_PROFILE_DIR=~/.cache/codeflow/browser/chrome-user-data
CODEFLOW_BROWSER_PROFILE_NAME=codeflow
CODEFLOW_BROWSER_PROFILE_ALLOWLIST=~/.cache/codeflow/browser
CODEFLOW_BROWSER_CDP_HOST=127.0.0.1
CODEFLOW_BROWSER_CDP_PORT=9341

# Optional CI diagnostics / route-evidence knobs (usually injected by workflow, not hand-authored locally)
CODEFLOW_CI_PROFILE=auto
CODEFLOW_CI_SLICE=full
CODEFLOW_DOCKER_CI_FORCE_REBUILD=0
CODEFLOW_CI_PROVENANCE_IMAGE=codeflow-ci-core:local
CODEFLOW_CI_ROUTE_ID=
CODEFLOW_CI_TRUST_CLASS=
CODEFLOW_CI_RUNNER_CLASS=
CODEFLOW_CI_CLOUD_BOOTSTRAP_ALLOWED=false
CODEFLOW_CI_CLOUD_BOOTSTRAP_USED=false
CODEFLOW_CI_CONTROL_PLANE_DOCTOR_OUT_DIR=.runtime-cache/test_output/ci_control_plane_doctor
CODEFLOW_DOCTOR_REQUIRE_DOCKER=1
CODEFLOW_DOCTOR_REQUIRE_SUDO=1
CODEFLOW_CI_PM_CHAT_ON_PR=0
CODEFLOW_UPSTREAM_RECORD_FRESH_SEC=1800
CODEFLOW_UPSTREAM_VERIFICATION_TIMEOUT_SEC=180
