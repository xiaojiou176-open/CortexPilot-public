# Agentcoder local minimal template (do not commit real secrets)
# Core ports and API auth
AGENTCODER_DEV_HOST=127.0.0.1
AGENTCODER_API_PORT=10000
AGENTCODER_DASHBOARD_PORT=3100
AGENTCODER_DESKTOP_PORT=18173
AGENTCODER_API_AUTH_REQUIRED=true
AGENTCODER_API_TOKEN=agentcoder-dev-token

# Frontend runtime wiring (public env for web / desktop shell token)
NEXT_PUBLIC_AGENTCODER_API_BASE=http://127.0.0.1:10000
NEXT_PUBLIC_AGENTCODER_API_TOKEN=agentcoder-dev-token
VITE_AGENTCODER_API_BASE=http://127.0.0.1:10000
VITE_AGENTCODER_API_TOKEN=agentcoder-dev-token
# Optional hosted/public dashboard origins (comma-separated, no secrets)
AGENTCODER_API_ALLOWED_ORIGINS=
# Later-gated queue pilot stays default-off unless a trusted operator environment enables it.
AGENTCODER_MCP_QUEUE_PILOT_ENABLE_APPLY=0

# Unified LLM provider selection
# Supported: gemini | openai | anthropic
AGENTCODER_PROVIDER=gemini
# Optional overrides (leave empty to use provider defaults)
AGENTCODER_PROVIDER_BASE_URL=
AGENTCODER_PROVIDER_MODEL=
AGENTCODER_PROVIDER_USE_LITELLM=0

# M10 SSOT alignment: prefer canonical MCP timeout keys for new config
AGENTCODER_MCP_TIMEOUT_SEC=
AGENTCODER_MCP_CONNECT_TIMEOUT_SEC=
AGENTCODER_MCP_CLEANUP_TIMEOUT_SEC=
# Compatibility keys are still registered; keep only for legacy/runtime compatibility
AGENTCODER_MCP_SERVER_TIMEOUT_SEC=
AGENTCODER_MCP_SERVER_CONNECT_TIMEOUT_SEC=
AGENTCODER_MCP_SERVER_CLEANUP_TIMEOUT_SEC=

# Provider credentials (fill only what you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_BASE_URL=

# Optional eval overrides
AGENTCODER_EVAL_MODEL=
AGENTCODER_EVAL_CONFIG=tests/evals/promptfoo/promptfooconfig.yaml

# Optional governance knobs
AGENTCODER_RUM_MAX_PAYLOAD_BYTES=32768
AGENTCODER_CI_CANARY_DRY_RUN=0
# Host compatibility only: set to 1 to bypass docker auto-routing for local gate diagnostics.
AGENTCODER_HOST_COMPAT=0
# Repo-authored runtime artifacts stay under .runtime-cache/. Repo-owned external caches stay under ~/.cache/agentcoder.
AGENTCODER_MACHINE_CACHE_ROOT=~/.cache/agentcoder
AGENTCODER_RETENTION_MACHINE_CACHE_CAP_BYTES=21474836480
AGENTCODER_MACHINE_CACHE_AUTO_PRUNE=1
AGENTCODER_MACHINE_CACHE_AUTO_PRUNE_INTERVAL_SEC=1800
# Local development uses the repo-owned Chrome singleton rooted under ~/.cache/agentcoder/browser/.
# First migrate the named default-Chrome profile once, then keep manual and automation flows attached to the same CDP endpoint.
CHROME_PATH=
AGENTCODER_BROWSER_PROFILE_MODE=allow_profile
AGENTCODER_BROWSER_PROFILE_DIR=~/.cache/agentcoder/browser/chrome-user-data
AGENTCODER_BROWSER_PROFILE_NAME=agentcoder
AGENTCODER_BROWSER_PROFILE_ALLOWLIST=~/.cache/agentcoder/browser
AGENTCODER_BROWSER_CDP_HOST=127.0.0.1
AGENTCODER_BROWSER_CDP_PORT=9341

# Optional CI diagnostics / route-evidence knobs (usually injected by workflow, not hand-authored locally)
AGENTCODER_CI_PROFILE=auto
AGENTCODER_CI_SLICE=full
AGENTCODER_DOCKER_CI_FORCE_REBUILD=0
AGENTCODER_CI_PROVENANCE_IMAGE=agentcoder-ci-core:local
AGENTCODER_CI_ROUTE_ID=
AGENTCODER_CI_TRUST_CLASS=
AGENTCODER_CI_RUNNER_CLASS=
AGENTCODER_CI_CLOUD_BOOTSTRAP_ALLOWED=false
AGENTCODER_CI_CLOUD_BOOTSTRAP_USED=false
AGENTCODER_CI_CONTROL_PLANE_DOCTOR_OUT_DIR=.runtime-cache/test_output/ci_control_plane_doctor
AGENTCODER_DOCTOR_REQUIRE_DOCKER=1
AGENTCODER_DOCTOR_REQUIRE_SUDO=1
AGENTCODER_CI_PM_CHAT_ON_PR=0
AGENTCODER_UPSTREAM_RECORD_FRESH_SEC=1800
AGENTCODER_UPSTREAM_VERIFICATION_TIMEOUT_SEC=180
