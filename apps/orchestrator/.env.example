# Orchestrator local development example
CODEFLOW_RUNTIME_ROOT=.runtime-cache/codeflow
CODEFLOW_SCHEMA_ROOT=schemas
CODEFLOW_CONTRACT_ROOT=contracts
CODEFLOW_RUNTIME_CONTRACT_ROOT=.runtime-cache/codeflow/contracts
CODEFLOW_WORKTREE_ROOT=.runtime-cache/codeflow/worktrees
CODEFLOW_RUNS_ROOT=.runtime-cache/codeflow/runs
CODEFLOW_REPO_ROOT=.
CODEFLOW_LOGS_ROOT=.runtime-cache/logs
CODEFLOW_CACHE_ROOT=.runtime-cache/cache
CODEFLOW_MACHINE_CACHE_ROOT=~/.cache/codeflow
CODEFLOW_RETENTION_MACHINE_CACHE_CAP_BYTES=21474836480
CODEFLOW_MACHINE_CACHE_AUTO_PRUNE=1
CODEFLOW_MACHINE_CACHE_AUTO_PRUNE_INTERVAL_SEC=1800

# API auth / local dashboard coupling
CODEFLOW_API_AUTH_REQUIRED=true
CODEFLOW_API_TOKEN=codeflow-dev-token
CODEFLOW_DASHBOARD_PORT=3100
CODEFLOW_API_ALLOWED_ORIGINS=
CODEFLOW_MCP_QUEUE_PILOT_ENABLE_APPLY=0
CODEFLOW_CANARY_PERCENT=0

# Provider + runtime timeout (M10 SSOT-aligned examples)
CODEFLOW_PROVIDER=gemini
CODEFLOW_MCP_TIMEOUT_SEC=
CODEFLOW_MCP_CONNECT_TIMEOUT_SEC=
CODEFLOW_MCP_CLEANUP_TIMEOUT_SEC=
# Compatibility keys remain in registry for legacy/runtime compatibility
CODEFLOW_MCP_SERVER_TIMEOUT_SEC=
CODEFLOW_MCP_SERVER_CONNECT_TIMEOUT_SEC=
CODEFLOW_MCP_SERVER_CLEANUP_TIMEOUT_SEC=

# Optional tracing placeholders
CODEFLOW_OTLP_ENDPOINT=
CODEFLOW_OTLP_HEADERS=
CODEFLOW_OTLP_PROTOCOL=grpc

# Local browser defaults: use the real Chrome profile named "codeflow" only on local host development.
# CI / docker / clean-room lanes force browser policy back to ephemeral and must not depend on login state.
# Local allow_profile now means the repo-owned singleton Chrome root under ~/.cache/codeflow/browser/chrome-user-data.
CHROME_PATH=
CODEFLOW_BROWSER_PROFILE_MODE=allow_profile
CODEFLOW_BROWSER_PROFILE_DIR=~/.cache/codeflow/browser/chrome-user-data
CODEFLOW_BROWSER_PROFILE_NAME=codeflow
CODEFLOW_BROWSER_PROFILE_ALLOWLIST=~/.cache/codeflow/browser
CODEFLOW_BROWSER_CDP_HOST=127.0.0.1
CODEFLOW_BROWSER_CDP_PORT=9341

# Optional upstream verification timing knobs
CODEFLOW_UPSTREAM_RECORD_FRESH_SEC=1800
CODEFLOW_UPSTREAM_VERIFICATION_TIMEOUT_SEC=180

# Optional eval overrides
CODEFLOW_EVAL_MODEL=
CODEFLOW_EVAL_CONFIG=tests/evals/promptfoo/promptfooconfig.yaml
